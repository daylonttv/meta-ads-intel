  "macroEvents": [
    {
      "date": "2026-07-07",
      "description": "US Average Gas Price Rises to $3.79/gallon",
      "details": "The average U.S. gas price reached $3.79 per gallon on July 7, 2026, marking a 20.5% increase from a year prior. While this was a slight decrease from the June 2026 monthly average of $4.05, and a more significant drop from May's $4.48, prices remained elevated compared to historical baselines. High gas prices reduce discretionary income, leading to increased financial anxiety among consumers. For a premium DTC food gifting brand, this generally suppresses spending on non-essential items, though the slight dip from previous months might have offered some temporary relief, contributing to the improved performance in early July.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "low",
      "source": "LendingTree, EIA, AAA"
    },
    {
      "date": "2026-07-13",
      "description": "Meta AI Ad Tools Cause 'Chaotic' Results for Advertisers",
      "details": "Reports emerged on July 13, 2026, detailing widespread issues with Meta's AI-powered advertising tools. Advertisers reported 'chaotic' results, including strangely twisted limbs, gibberish text, or entirely changed products in AI-generated ad creatives. These AI automation features are often enabled by default, and despite Meta's push for their use, many brands found them clunky and prone to misrepresentation. Such issues can lead to wasted ad spend, negative brand perception, and reduced conversion rates, potentially contributing to inconsistent ROAS and CPA if not carefully managed.",
      "intensity": 2,
      "category": "platform",
      "icon": "🔴",
      "mood_impact": "neutral",
      "feed_dominance": "low",
      "source": "Business Insider"
    },
    {
      "date": "2026-07-19",
      "description": "FIFA World Cup Final Concludes in US, Canada, Mexico",
      "details": "The FIFA World Cup, co-hosted by the United States, Canada, and Mexico, concluded on July 19, 2026, with the final match held at MetLife Stadium in New Jersey. This major international sporting event generated significant public interest and media coverage throughout its duration (June 11 - July 19). While the event itself boosts national pride, the final match day would have created a massive 'feed domination' effect, with many consumers focused on watching the game and related content. This intense focus on a major event can divert attention from ads, leading to lower conversion intent and potentially suppressed ROAS on or around the final day.",
      "intensity": 3,
      "category": "feed",
      "icon": "📱",
      "mood_impact": "neutral",
      "feed_dominance": "high",
      "source": "FIFA, Wikipedia, Roadtrips"
    },
    {
      "date": "2026-07-27",
      "description": "US Gas Prices Continue Upward Trend to $4.09/gallon",
      "details": "Following a brief dip in early July, the average U.S. regular gasoline price resumed an upward trend, reaching $4.096 per gallon by July 27, 2026. This price was significantly higher than the previous year and reflected ongoing instability in crude oil markets, particularly along the Strait of Hormuz. Sustained high gas prices directly impact consumer discretionary spending, as more household budget is allocated to fuel. This financial pressure tends to make consumers more cautious about non-essential purchases, leading to suppressed spending on premium food gifting and contributing to lower ROAS and higher CPA.",
      "intensity": 2,
