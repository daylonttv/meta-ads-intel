    {
      "date": "2026-07-19",
      "description": "Global Meta Outage Disrupts Facebook and Instagram",
      "details": "Thousands of Facebook and Instagram users worldwide reported service outages, including login failures, inaccessible accounts, and difficulties loading content. This global disruption, which also affected ad delivery, was significant enough to cause widespread 'doomscrolling' on other platforms and displace product discovery, sharply reducing conversion intent for ads.",
      "intensity": 3,
