  "macroEvents": [
    {
      "date": "2026-07-14",
      "description": "June 2026 CPI shows 0.4% decrease, largest monthly decline since April 2020",
      "details": "The Consumer Price Index for All Urban Consumers (CPI-U) decreased by 0.4 percent on a seasonally adjusted basis in June, following a 0.5 percent rise in May. This marked the largest one-month decrease since April 2020. The decline was significantly driven by a 9.7 percent decrease in the gasoline index. This positive inflation news could have temporarily boosted consumer confidence, but its impact might have been short-lived given other economic indicators and subsequent gas price increases. The CPI for July 2026 was scheduled for release on August 12, 2026.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "boosts_spending",
      "feed_dominance": "low",
      "source": "Bureau of Labor Statistics"
    },
    {
      "date": "2026-07-16",
      "description": "Meta Ads Delivery incident reported for 2+ hours",
      "details": "Meta's status page logged an Ads Delivery incident on July 16, acknowledged for 2 hours and 7 minutes, though the actual start was likely earlier. This type of platform issue can disrupt ad delivery and pacing, leading to decreased impressions, inefficient spending, and lower conversion rates. For a DTC brand, this directly translates to reduced ROAS and increased CPA due to impaired ad performance. This incident directly correlates with the anomalous bad performance on July 16th.",
      "intensity": 3,
      "category": "platform",
      "icon": "🔴",
      "mood_impact": "neutral",
      "feed_dominance": "low",
      "source": "Meta Status Page / AdMake AI Blog"
    },
    {
      "date": "2026-07-21",
      "description": "National average gas price jumps 15 cents to $4.09, crude oil hits $90/barrel",
      "details": "The national average for a gallon of regular gasoline surged by 15 cents from the previous week, reaching $4.09 and officially crossing the $4.00 mark on July 20. This spike was attributed to rising crude oil prices, which entered the $90 per barrel range due to instability along the Strait of Hormuz. Higher gas prices reduce consumers' discretionary income, leading to suppressed spending on non-essential items like specialty food gifts. This event likely contributed to the poor performance on July 21st.",
      "intensity": 3,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "medium",
      "source": "AAA / CarBuzz"
    },
    {
      "date": "2026-07-28",
      "description": "Conference Board Consumer Confidence declines to 90.8 in July",
      "details": "The Conference Board Consumer Confidence Index decreased by 1.4 points to 90.8 in July, down from an upwardly revised 92.2 in June. The Present Situation Index fell for the third consecutive month to 114.9, indicating worsening views of current business and labor market conditions. The Expectations Index remained unchanged at 74.7, staying below the recession signal threshold of 80. This overall decline in consumer confidence, particularly concerning present economic conditions, suggests increased financial anxiety, which typically suppresses discretionary spending and gifting. This aligns with the poor performance on July 27th and 28th.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "low",
      "source": "The Conference Board / PR Newswire"
