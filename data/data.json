  "macroEvents": [
    {
      "date": "2026-07-21",
      "description": "Meta launches Generative Recommender, an LLM-powered ad ranking system.",
      "details": "Meta announced the launch of its Generative Recommender, an AI-driven ad ranking system, on its Q2 2026 earnings call. This new system uses a large language model to evaluate ad creative and user preferences, aiming to improve ad delivery and conversion rates. Early trials showed a 15.7% increase in conversions on Facebook and a 1% lift in app-event conversions on Instagram. Expected impact: Potentially volatile in the short term as the algorithm adjusts, but long-term positive for ROAS and CPA for advertisers who adapt to creative-based targeting. Initial dips could be due to system recalibration.",
      "intensity": 2,
      "category": "platform",
      "icon": "🔴",
      "mood_impact": "neutral",
      "feed_dominance": "low",
      "source": "Common Thread Collective, AdBeacon"
    },
    {
      "date": "2026-07-23",
      "description": "US national average gas price jumps 15 cents to $4.09/gallon.",
      "details": "The national average for a gallon of regular gasoline surged by 15 cents from the previous week, reaching $4.09. This increase pushed most states to $4 per gallon or higher, driven by rising crude oil prices and instability in the Strait of Hormuz. Specialty food, being a discretionary purchase, is highly sensitive to increased household expenses like fuel. Expected impact: Suppresses Meta ROAS and increases CPA as consumers face higher discretionary spending costs and may reduce non-essential purchases.",
      "intensity": 3,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "medium",
      "source": "AAA Newsroom"
    },
    {
      "date": "2026-07-27",
      "description": "Meta removes 'Your activity off Meta technologies' opt-out, expanding retargeting pools.",
      "details": "Meta began rolling out a significant change by removing the 'Your activity off Meta technologies' opt-out setting. This privacy control previously allowed users to disconnect their off-platform activity from their Meta accounts. Its removal means that data from previously opted-out users can now be linked to their profiles, potentially expanding retargeting audience sizes and improving audience quality for advertisers. Expected impact: Boosts Meta ROAS and lowers CPA for brands utilizing retargeting and Custom Audiences, as more complete user data becomes available for optimization.",
      "intensity": 2,
      "category": "platform",
      "icon": "🔴",
      "mood_impact": "neutral",
      "feed_dominance": "low",
      "source": "AdBeacon, Meta Business Blog"
    },
    {
      "date": "2026-07-28",
      "description": "Conference Board Consumer Confidence Index falls to 90.8 in July.",
      "details": "The Conference Board Consumer Confidence Index decreased by 1.4 points to 90.8 in July, down from an upwardly revised 92.2 in June. The Present Situation Index fell for the third consecutive month, and the Expectations Index remained at 74.7, below the 80-point threshold often associated with recession risk. This indicates a continued erosion of consumer optimism about current and future economic conditions. Expected impact: Suppresses Meta ROAS and increases CPA as consumers become more cautious with discretionary spending due to economic anxiety.",
      "intensity": 3,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "medium",
      "source": "The Conference Board, PR Newswire"
    },
    {
