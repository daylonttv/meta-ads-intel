    {
      "date": "2026-07-10",
      "description": "Meta Rolls Out 'Push Delivery to This Ad' Feature",
      "details": "Meta completed the rollout of its 'Push Delivery to This Ad' feature to nearly all ad accounts. This new manual delivery override allows advertisers to force 20-30% of an ad set's budget to a chosen ad for up to seven days, without resetting the learning phase. This feature aims to address the common issue of new creative not spending due to incumbent ads dominating the budget, potentially boosting ROAS for new, high-performing creative.",
      "intensity": 2,
      "category": "platform",
      "icon": "🔴",
      "mood_impact": "neutral",
      "feed_dominance": "low",
      "source": "AdMake AI Blog"
    },
    {
      "date": "2026-07-14",
      "description": "June CPI Shows Unexpected Decline, Energy Prices Fall",
      "details": "The U.S. Bureau of Labor Statistics reported that the Consumer Price Index for All Urban Consumers (CPI-U) decreased 0.4% on a seasonally adjusted basis in June, the largest one-month decrease since April 2020. The energy index notably fell by 5.7%. This unexpected decline in inflation, particularly in energy, could alleviate consumer financial anxiety and potentially boost discretionary spending.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "boosts_spending",
      "feed_dominance": "medium",
      "source": "Bureau of Labor Statistics"
    },
