  "macroEvents": [
    {
      "date": "2026-07-14",
      "description": "June CPI shows inflation cooling as energy prices plunge.",
      "details": "The Consumer Price Index (CPI) measures the average change over time in the prices paid by urban consumers for a market basket of consumer goods and services. The June 2026 CPI report indicated that inflation was cooling, largely due to a significant plunge in energy prices. This news typically signals a more stable economic environment, potentially easing financial pressure on consumers. For a DTC food gifting brand, this could lead to a slight boost in consumer confidence and discretionary spending, resulting in improved ROAS and lower CPA as consumers feel more secure about their finances.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "boosts_spending",
      "feed_dominance": "medium",
      "source": "Bureau of Labor Statistics"
    },
    {
      "date": "2026-07-16",
      "description": "National gas average rises 10 cents, nearing $4 per gallon.",
      "details": "Gas prices are a significant factor in consumer discretionary spending, as higher fuel costs reduce the amount of money available for other purchases. On July 16, 2026, the national average for a gallon of regular gasoline increased by 10 cents to $3.94, inching closer to the psychologically important $4 mark. This upward trend in gas prices can lead to increased financial anxiety among consumers, potentially suppressing discretionary spending on non-essential items like specialty food gifts, resulting in lower ROAS and higher CPA.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "low",
      "source": "AAA"
    },
    {
      "date": "2026-07-23",
      "description": "National gas average jumps 15 cents to $4.09, most states above $4.",
      "details": "Continuing the upward trend, the national average for a gallon of regular gasoline surged by 15 cents to $4.09, with most states now seeing prices at or above $4 per gallon. This significant jump in fuel costs, driven by crude oil price volatility along the Strait of Hormuz, directly impacts household budgets. Such a sharp increase in a necessary expense like gas can severely dampen consumer sentiment and reduce discretionary income, leading to a notable decrease in ROAS and an increase in CPA for a premium gifting brand.",
      "intensity": 3,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "medium",
      "source": "AAA"
    },
    {
      "date": "2026-07-28",
      "description": "Conference Board Consumer Confidence Index falls to 90.8 in July.",
      "details": "The Conference Board Consumer Confidence Index measures consumers' attitudes and buying intentions, reflecting prevailing business conditions and likely developments. In July 2026, the index decreased by 1.4 points to 90.8 from an upwardly revised 92.2 in June, marking its third consecutive monthly decline in the Present Situation Index. This decline, surveyed between July 1-22 amidst ongoing Middle East conflict, indicates growing consumer pessimism about current and future economic conditions. Reduced confidence typically translates to less discretionary spending, negatively impacting ROAS and increasing CPA for a gifting brand.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "low",
      "source": "The Conference Board"
    },
