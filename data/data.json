  "macroEvents": [
    {
      "date": "2026-07-23",
      "description": "National average gas price jumps to $4.09/gallon, highest since 2022.",
      "details": "The national average for a gallon of regular gasoline increased by 15 cents from the previous week, reaching $4.09. This marks the highest price point since 2022, driven by rising crude oil prices and volatility in the Strait of Hormuz. For a premium DTC food brand, higher gas prices reduce discretionary income, leading to suppressed spending on non-essential items like artisan cheese.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "medium",
      "source": "AAA Newsroom"
    },
    {
      "date": "2026-07-28",
      "description": "Conference Board Consumer Confidence declines to 90.8 in July.",
      "details": "The Conference Board Consumer Confidence Index decreased by 1.4 points to 90.8 in July, down from an upwardly revised 92.2 in June. The Present Situation Index fell for the third consecutive month, and the Expectations Index remained below 80, a level historically associated with recession risk. This sustained decline in confidence indicates growing consumer pessimism about current and future economic conditions, likely reducing willingness to spend on discretionary luxury items.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "low",
      "source": "The Conference Board"
    },
    {
      "date": "2026-07-29",
      "description": "Federal Reserve holds interest rates steady amid inflation concerns.",
      "details": "The Federal Reserve voted 9-3 to maintain the benchmark federal funds rate at 3.5% to 3.75% for the fifth consecutive meeting. Despite the hold, three members dissented, preferring a rate hike due to elevated inflation, which remains above the Fed's 2% target. This decision signals ongoing economic uncertainty and persistent inflation, which can make consumers hesitant about discretionary spending.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "neutral",
      "feed_dominance": "medium",
      "source": "Federal Reserve / Fox Business"
    },
    {
      "date": "2026-07-30",
      "description": "US Q2 GDP advance estimate shows slower 1.5% growth.",
      "details": "The U.S. Bureau of Economic Analysis (BEA) released its advance estimate for Q2 2026 GDP, showing an annual growth rate of 1.5%, a slowdown from 2.1% in Q1 and below economist forecasts. While consumer spending and investment increased, overall growth was partly offset by decreased government spending. Slower economic growth can temper consumer optimism and lead to more cautious spending habits, especially for premium goods.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "medium",
      "source": "U.S. Bureau of Economic Analysis (BEA)"
    },
    {
      "date": "2026-07-31",
      "description": "U of M Consumer Sentiment revised up to 55.2 in July.",
