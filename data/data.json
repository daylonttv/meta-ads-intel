  "macroEvents": [
    {
      "date": "2026-07-04",
      "description": "Independence Day (US Semiquincentennial) with increased spending and travel",
      "details": "The Fourth of July, America's 250th birthday, was a major holiday with an estimated $15.5 billion in total consumer spending projected, including $9.4 billion on food. Travel was also expected to be high, with 72.2 million Americans traveling 50+ miles from home. While overall spending was up, the holiday itself often shifts consumer focus away from online shopping for non-immediate needs, leading to lower conversion rates despite high traffic. The significant focus on immediate holiday celebrations and travel likely diverted attention and budget, causing the observed drop in ROAS and increase in CPA for a DTC food gifting brand.",
      "intensity": 3,
      "category": "seasonal",
      "icon": "🗓️",
      "mood_impact": "neutral",
      "feed_dominance": "high",
      "source": "Capital One Shopping, NRF, Plus500, WalletHub"
    },
    {
      "date": "2026-07-07",
      "description": "US average gas price surges to $3.79/gallon, up 20.5% YoY",
      "details": "The U.S. average gas price surged to $3.79 per gallon on July 7, 2026, marking a 20.5% increase from a year earlier. This significant jump in fuel costs can directly impact consumer discretionary spending. Higher gas prices typically lead to reduced purchasing power and increased financial anxiety, which can suppress spending on non-essential goods like premium cheese. This rise in gas prices could explain the slight dip in performance following the strong post-holiday rebound.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "suppresses_spending",
      "feed_dominance": "medium",
      "source": "LendingTree"
    },
    {
      "date": "2026-07-14",
      "description": "June CPI rises 3.5% YoY, energy prices fall 5.7% MoM",
      "details": "The Consumer Price Index (CPI) for June 2026 showed a 3.5% increase year-over-year, a decrease from May's 4.2%. Energy prices, particularly gasoline, fell 5.7% month-over-month. While overall inflation remained elevated, the monthly drop in energy prices could have provided some relief to consumers. This mixed signal might lead to cautious but not entirely suppressed spending, potentially contributing to the positive ROAS observed around this time, as consumers might feel a slight easing of immediate cost pressures.",
      "intensity": 2,
      "category": "wallet",
      "icon": "💰",
      "mood_impact": "neutral",
      "feed_dominance": "low",
      "source": "Bureau of Labor Statistics, Stephens Inc."
    },
    {
      "date": "2026-07-11",
      "description": "FIFA World Cup 2026 in full swing, final on July 19th",
      "details": "The FIFA World Cup, co-hosted by the United States, Canada, and Mexico, ran from June 11 to July 19, 2026, with the final on July 19th. Major sporting events like this can dominate social media feeds and consumer attention, diverting focus from advertising. While the initial days of the tournament might have had a 'novelty' effect, as the tournament progressed, especially towards the final, feed dominance would increase. This event could explain some of the fluctuations in ad performance, as consumer attention shifts between the game and online browsing.",
      "intensity": 2,
      "category": "feed",
